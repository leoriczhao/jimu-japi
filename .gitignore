# Build outputs
build/
src/build/
src/build10/

# Local config (user-specific paths)
tools/config.local.ps1

# Logs
*.log
tools/w3x2lni/log/

# DLL output
*.dll
*.tga

# IDE
.vs/
.vscode/
*.user
*.suo

# Agent tooling
.claude/
.qoder/

# OS
Thumbs.db
Desktop.ini

# Binary map files (use LNI text format instead)
*.w3x
*.w3m

# w3x2lni: the Lua/data tree belongs to upstream (sumneko/w3x2lni) and is restored by
# tools/fetch-w3x2lni.ps1; only the compiled runtime is tracked.
tools/w3x2lni/*
!tools/w3x2lni/bin/
!tools/w3x2lni/bin/*.dll
!tools/w3x2lni/w2l.exe
!tools/w3x2lni/w3x2lni.exe

# Reference: ignored subdirs (submodules or not needed)
reference/ujapi/
reference/old-japi/
.alma-snapshots
