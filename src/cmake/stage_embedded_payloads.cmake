# Generates embedded_paths.h + d3d9.sha256 for compiling embedded_payloads.rc
# into yd_japi.dll (mirrors builtin-japi's single-TGA PE .rsrc payload layout).

if(NOT DEFINED D3D9_DLL OR NOT EXISTS "${D3D9_DLL}")
    message(FATAL_ERROR "stage_embedded_payloads: D3D9_DLL not found: '${D3D9_DLL}'")
endif()
if(NOT DEFINED OUT_DIR)
    message(FATAL_ERROR "stage_embedded_payloads: OUT_DIR is required")
endif()

file(MAKE_DIRECTORY "${OUT_DIR}")

file(SHA256 "${D3D9_DLL}" D3D9_SHA256_LOWER)
string(TOUPPER "${D3D9_SHA256_LOWER}" D3D9_SHA256_UPPER)

set(SHA_FILE "${OUT_DIR}/d3d9.sha256")
set(OLD_SHA "")
if(EXISTS "${SHA_FILE}")
    file(READ "${SHA_FILE}" OLD_SHA)
endif()
if(NOT "${OLD_SHA}" STREQUAL "${D3D9_SHA256_UPPER}")
    file(WRITE "${SHA_FILE}" "${D3D9_SHA256_UPPER}")
endif()

file(TO_CMAKE_PATH "${D3D9_DLL}" D3D9_DLL_CMAKE)
file(TO_CMAKE_PATH "${SHA_FILE}" SHA_FILE_CMAKE)

set(HDR_CONTENT "// Auto-generated by stage_embedded_payloads.cmake\n")
string(APPEND HDR_CONTENT "#define JAPI_EMBED_D3D9_DLL_PATH \"${D3D9_DLL_CMAKE}\"\n")
string(APPEND HDR_CONTENT "#define JAPI_EMBED_D3D9_SHA256_PATH \"${SHA_FILE_CMAKE}\"\n")
string(APPEND HDR_CONTENT "#define JAPI_EMBED_D3D9_SHA256_VALUE \"${D3D9_SHA256_UPPER}\"\n")

if(DEFINED D3DX_DLL AND NOT "${D3DX_DLL}" STREQUAL "" AND EXISTS "${D3DX_DLL}")
    file(TO_CMAKE_PATH "${D3DX_DLL}" D3DX_DLL_CMAKE)
    string(APPEND HDR_CONTENT "#define JAPI_EMBED_D3DX_DLL_PATH \"${D3DX_DLL_CMAKE}\"\n")
endif()

set(HDR_FILE "${OUT_DIR}/embedded_paths.h")
set(OLD_HDR "")
if(EXISTS "${HDR_FILE}")
    file(READ "${HDR_FILE}" OLD_HDR)
endif()
if(NOT "${OLD_HDR}" STREQUAL "${HDR_CONTENT}")
    file(WRITE "${HDR_FILE}" "${HDR_CONTENT}")
endif()

message(STATUS "Embedded payload manifest updated (newD3d9.dll SHA-256: ${D3D9_SHA256_UPPER})")
